# ---------------------------------------------------------------------------
# XRPL NFT layer. Copy to .env and fill in. NEVER commit the filled-in file.
# ---------------------------------------------------------------------------

# Primary WebSocket endpoint. Never hardcode this in source.
#
# MUST be a Clio-enabled server: nft_info, nft_history and nfts_by_issuer are
# Clio methods and return `unknownCmd` on a plain rippled node. Verified:
#   wss://clio.altnet.rippletest.net:51233   Clio, testnet          <- testnet
#   wss://s.altnet.rippletest.net:51233      plain rippled, testnet  (no NFT queries)
#   wss://s1.ripple.com                      Clio 2.7.1, MAINNET     <- mainnet
#   wss://s2.ripple.com                      Clio 2.7.1, mainnet      (fallback)
#   wss://xrplcluster.com                    plain rippled, mainnet   (no NFT queries)
#
# The brief names xrplcluster.com for mainnet and says it serves Clio. Measured
# 2026-08-20: it does NOT — 0 of 8 connections had clio_version, and
# nfts_by_issuer returned unknownCmd every time. Use s1/s2.ripple.com.
XRPL_ENDPOINT=wss://clio.altnet.rippletest.net:51233
# Comma-separated fallbacks. Public Clio servers carry no SLA, so set at least one.
XRPL_FALLBACK_ENDPOINTS=wss://s.altnet.rippletest.net:51233

# Guard rail. testnet | devnet | mainnet
# Startup asserts that mainnet is never paired with an altnet/devnet endpoint.
XRPL_NETWORK=testnet

# Issuer credentials. ISSUER_SEED is server-side only and must never be
# shipped to a client bundle or written to a log line.
ISSUER_SEED=
ISSUER_ADDRESS=

# Sponsorship of unactivated attendee wallets.
SPONSOR_ENABLED=true
SPONSOR_AMOUNT_XRP=1.5
# Hard daily ceiling on total sponsored XRP. Drain protection.
SPONSOR_DAILY_CAP_XRP=50

# IPFS metadata hosting.
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud

# ---------------------------------------------------------------------------
# Xaman (formerly XUMM). Free credentials from https://apps.xaman.dev — you
# sign in by scanning a QR with the Xaman app, then create an application.
#
# REQUIRED FOR REGISTRATION. Attendees prove they control a wallet by approving
# a Xaman SignIn; without these the registration routes 500 and nobody can
# register. There is deliberately no "just type your address" fallback: an
# unverified address is a claim rather than a proof, and a badge minted to the
# wrong wallet cannot be recovered because it is soulbound.
#
# One application covers testnet and mainnet — a SignIn is a signature, not a
# transaction, so it carries no network of its own.
#
# The SECRET is server-side only. It must never reach a browser.
# ---------------------------------------------------------------------------
XUMM_API_KEY=
XUMM_API_SECRET=

# What a badge's metadata points at for its image: https | ipfs
#
# https (default) uses the pinning gateway and renders immediately. ipfs is
# content-addressed but a freshly pinned CID is unfindable on public gateways
# for HOURS, and wallets resolve ipfs:// through their own gateway — measured:
# a 676-byte metadata JSON reached ipfs.io in seconds while its 313 KB image
# still timed out long after. The choice is permanent per badge, because the
# metadata CID goes into an immutable NFTokenMint URI. Use ipfs only when you
# pre-pin the roster well ahead of the event with `npm run prepin`.
BADGE_IMAGE_URI_MODE=https

# What NFTokenMint's URI field points at: https | ipfs
#
# ipfs:// is the XLS-24d standard. Measured across Xaman, Bithomp and
# testnet.xrpl.org, it is also the one none of them render — they show the raw
# ipfs://CID string and never resolve it. https puts the gateway URL on the
# token so any viewer can fetch it with a plain GET. The CID is still inside
# that URL, so the bytes stay content-addressed and re-pinnable.
#
# PERMANENT PER BADGE — NFTokenMint's URI cannot be edited after minting.
# selfhosted also available — see BADGE_BASE_URL below.
BADGE_METADATA_URI_MODE=https

# Public origin badge metadata and art are served from, for
# BADGE_METADATA_URI_MODE=selfhosted. e.g. https://badges.example.com
#
# WHY SELF-HOST. Measured: gateway.pinata.cloud serves a 700-byte metadata JSON
# in 4-7 SECONDS even on a cache hit. testnet.xrpl.org renders it because the
# fetch runs in the viewer's browser and waits; Xaman and Bithomp resolve
# server-side on a timeout and give up, showing a blank tile. Served from here
# the same bytes come back in milliseconds.
#
# PERMANENT: this origin lands inside an immutable NFTokenMint URI. Never point
# it at an ngrok tunnel or any hostname you might not keep.
BADGE_BASE_URL=

# Attribution tag stamped on every transaction this app submits, and on the
# accept payload the attendee signs in Xaman. A uint32 (0 .. 4294967295). It
# moves no funds and changes no behaviour — it just makes this app's traffic
# identifiable on the ledger. Same value on testnet and mainnet.
SOURCE_TAG=2607210007

# Label drawn on the badge artwork. Used for BOTH the preview a page renders
# and the image pinned to IPFS, so there is only one place to set it.
EVENT_NAME=

# Default NFTokenMint URI, used when a claim request does not supply its own.
# Points at the metadata JSON, not the image. Max 256 bytes.
EVENT_METADATA_URI=

# Testnet-only click-through demo at GET /demo. It generates wallets, takes
# faucet funds and signs as an attendee, so it REFUSES TO BOOT on mainnet
# instead of quietly turning itself off. `npm run demo` sets this for you.
DEMO_ENABLED=false

# ---------------------------------------------------------------------------
# Admin login. One operator account.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=
# Generate with:  npm run admin:hash
# This is a scrypt hash, never the password itself.
ADMIN_PASSWORD_HASH=
# Signs the session cookie. Any long random string; rotating it logs everyone
# out. Generate with:  openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_HOURS=12

# true behind HTTPS, false on plain-http localhost. A Secure cookie is never
# sent over http, and the symptom is a login that silently does nothing.
SECURE_COOKIES=false

# Attendance index.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/xrpl_poap

# API surface.
PORT=3000
HOST=127.0.0.1

# Trust X-Forwarded-For? Rate limiting is keyed on the client IP, so behind an
# ingress this must be set or every attendee shares one bucket. Leave false
# when the API is directly exposed — trusting a spoofable header hands an
# attacker unlimited buckets. Accepts true/false or an address/CIDR list.
TRUST_PROXY=false
