# ---------------------------------------------------------------------------
# XRPL NFT layer. Copy to .env and fill in. NEVER commit the filled-in file.
# ---------------------------------------------------------------------------

# Primary WebSocket endpoint. Never hardcode this in source.
#
# MUST be a Clio-enabled server: nft_info, nft_history and nfts_by_issuer are
# Clio methods and return `unknownCmd` on a plain rippled node. Verified:
#   wss://clio.altnet.rippletest.net:51233   Clio, testnet          <- testnet
#   wss://s.altnet.rippletest.net:51233      plain rippled, testnet  (no NFT queries)
#   wss://s1.ripple.com                      Clio 2.7.1, MAINNET     <- mainnet
#   wss://s2.ripple.com                      Clio 2.7.1, mainnet      (fallback)
#   wss://xrplcluster.com                    plain rippled, mainnet   (no NFT queries)
#
# The brief names xrplcluster.com for mainnet and says it serves Clio. Measured
# 2026-08-20: it does NOT — 0 of 8 connections had clio_version, and
# nfts_by_issuer returned unknownCmd every time. Use s1/s2.ripple.com.
XRPL_ENDPOINT=wss://clio.altnet.rippletest.net:51233
# Comma-separated fallbacks. Public Clio servers carry no SLA, so set at least one.
XRPL_FALLBACK_ENDPOINTS=wss://s.altnet.rippletest.net:51233

# Guard rail. testnet | devnet | mainnet
# Startup asserts that mainnet is never paired with an altnet/devnet endpoint.
XRPL_NETWORK=testnet

# Issuer credentials. ISSUER_SEED is server-side only and must never be
# shipped to a client bundle or written to a log line.
ISSUER_SEED=
ISSUER_ADDRESS=

# Sponsorship of unactivated attendee wallets.
SPONSOR_ENABLED=true
SPONSOR_AMOUNT_XRP=1.5
# Hard daily ceiling on total sponsored XRP. Drain protection.
SPONSOR_DAILY_CAP_XRP=50

# IPFS metadata hosting.
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud

# Xaman (formerly XUMM) — only needed for phone-based attendee signing.
XUMM_API_KEY=
XUMM_API_SECRET=

# Label drawn on the badge artwork. Used for BOTH the preview a page renders
# and the image pinned to IPFS, so there is only one place to set it.
EVENT_NAME=

# Default NFTokenMint URI, used when a claim request does not supply its own.
# Points at the metadata JSON, not the image. Max 256 bytes.
EVENT_METADATA_URI=

# Testnet-only click-through demo at GET /demo. It generates wallets, takes
# faucet funds and signs as an attendee, so it REFUSES TO BOOT on mainnet
# instead of quietly turning itself off. `npm run demo` sets this for you.
DEMO_ENABLED=false

# ---------------------------------------------------------------------------
# Admin login. One operator account.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=
# Generate with:  npm run admin:hash
# This is a scrypt hash, never the password itself.
ADMIN_PASSWORD_HASH=
# Signs the session cookie. Any long random string; rotating it logs everyone
# out. Generate with:  openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_HOURS=12

# true behind HTTPS, false on plain-http localhost. A Secure cookie is never
# sent over http, and the symptom is a login that silently does nothing.
SECURE_COOKIES=false

# Attendance index.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/xrpl_poap

# API surface.
PORT=3000
HOST=127.0.0.1

# Trust X-Forwarded-For? Rate limiting is keyed on the client IP, so behind an
# ingress this must be set or every attendee shares one bucket. Leave false
# when the API is directly exposed — trusting a spoofable header hands an
# attacker unlimited buckets. Accepts true/false or an address/CIDR list.
TRUST_PROXY=false
